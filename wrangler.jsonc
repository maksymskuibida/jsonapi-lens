{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jsonapi-lens",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-17",

  "routes": [
    {
      "pattern": "jsonapi.mstool.dev",
      "zone_name": "mstool.dev",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Paths are resolved in the browser, so every non-asset path still has to
    // return the single page (`/view`, `/d/<id>#<secret>`, the legal pages) — but `"single-page-application"` returns it with
    // `200 OK` for *any* path, which makes `/nope` indistinguishable from
    // `/view` to a crawler, a link checker or `curl -f`. `"none"` sends those
    // requests to the Worker instead, and `worker.ts#serveShell` decides the
    // status with the same `parseRoute` the client routes with.
    //
    // A path that does match an asset is still served without waking the
    // Worker, so `/assets/*` costs nothing extra.
    "not_found_handling": "none",
    // The share API has to reach the Worker ahead of asset matching; every
    // other path reaches it by not matching an asset at all.
    "run_worker_first": ["/api/*"]
  },

  // Share storage. The Worker only ever sees ciphertext: documents are gzipped
  // and encrypted in the browser with a key that lives in the share URL and is
  // never sent in a request body. D1 holds the numeric id and the expiry; R2
  // holds the opaque blob, because payloads are far larger than a D1 row.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jsonapi-lens-shares",
      "database_id": "f0903183-f366-438e-835c-b31aaaf62680",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "jsonapi-lens-shares"
    }
  ],


  // Workers Logs stays on for the Worker's own `console.*` output and its
  // exceptions, but the per-request invocation log is off (QA4).
  //
  // That log is one entry per invocation carrying the request method and
  // URL, and request metadata and headers, retained for 7 days. Since #26 every
  // page path (`not_found_handling: "none"`) invokes this Worker, so a legacy
  // `/d/<id>:<key>` link, or one whose `#` was rewritten to `%23`, would have
  // written its key into that log. The fragment of an ordinary link never
  // reaches the server, so nothing else is affected — but the log cannot tell
  // the two apart, and there is no redaction. Off is the only setting that
  // closes it. `head_sampling_rate` is deliberately untouched. See
  // docs/DECISIONS.md D7's QA4 amendment for what this costs the operator.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
