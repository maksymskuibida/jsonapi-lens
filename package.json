{
  "name": "jsonapi-lens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-page JSON:API document viewer — paste a payload, click through relationships via native URL anchors. Static, client-side, no backend.",
  "keywords": [
    "json:api",
    "jsonapi",
    "json-api",
    "json-api-viewer",
    "json-viewer",
    "api-response-viewer",
    "api-debugging",
    "relationships",
    "included",
    "resource-graph",
    "developer-tools",
    "client-side",
    "no-backend",
    "indexeddb",
    "content-visibility",
    "typescript",
    "vite",
    "cloudflare-workers"
  ],
  "homepage": "https://jsonapi.mstool.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maksymskuibida/jsonapi-lens.git"
  },
  "bugs": {
    "url": "https://github.com/maksymskuibida/jsonapi-lens/issues"
  },
  "author": "Maksym Skuibida",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/gen-fixture.mjs",
    "og": "scripts/render-og.sh",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
