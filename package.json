{
  "name": "jsonapi-lens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-page JSON:API document viewer — paste a payload, click through relationships via native URL anchors. Static, client-side, no backend.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/gen-fixture.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
