{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // `worker-configuration.d.ts` is generated by `wrangler types` from the
  // bindings in wrangler.jsonc, so the Env type can never drift from the config.
  //
  // `src/router.ts` is in here because the Worker decides `200` or `404` with
  // the same `parseRoute` the client routes with. It is listed explicitly, and
  // it holds no browser globals on purpose (`src/navigation.ts` does) — under
  // `lib: ["ES2022"]` above, a stray `location` would fail this typecheck,
  // which is the point.
  "include": ["src/worker.ts", "src/router.ts", "worker-configuration.d.ts"]
}
