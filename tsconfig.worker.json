{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // `worker-configuration.d.ts` is generated by `wrangler types` from the
  // bindings in wrangler.jsonc, so the Env type can never drift from the config.
  "include": ["src/worker.ts", "worker-configuration.d.ts"]
}
